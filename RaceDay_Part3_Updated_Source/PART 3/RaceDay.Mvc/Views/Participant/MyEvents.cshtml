@model JsonDocument?

@{
    ViewData["Title"] = "My events";
}

<h1>My events</h1>

@if (Model is not null)
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.RootElement.EnumerateArray())
                {
                    <tr>
                        <td>@x.GetProperty("eventName").GetString()</td>
                        <td>@x.GetProperty("categoryName").GetString()</td>
                        <td>@x.GetProperty("distanceKm").ToString() km</td>
                        <td>
                            <span class="badge @(x.GetProperty("status").GetString() == "Confirmed" ? "bg-success" : x.GetProperty("status").GetString() == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                                @x.GetProperty("status").GetString()
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No enrolments could be loaded.</div>
}