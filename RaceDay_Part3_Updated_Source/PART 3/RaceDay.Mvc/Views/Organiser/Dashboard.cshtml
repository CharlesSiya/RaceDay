@using System.Text.Json
@{ ViewData["Title"] = "Organiser dashboard"; var events = ViewBag.Events as JsonDocument; var enrolments = ViewBag.Enrolments as JsonDocument; var eventItems = events?.RootElement.ValueKind == JsonValueKind.Array ? events.RootElement.EnumerateArray().ToList() : new List<JsonElement>(); var enrolmentCount = enrolments?.RootElement.ValueKind == JsonValueKind.Array ? enrolments.RootElement.GetArrayLength() : 0; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><h1 class="mb-1">Organiser dashboard</h1><p class="text-secondary mb-0">Your events, entries and race-day operations.</p></div><a class="btn btn-primary" asp-action="CreateEvent">+ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span class="text-secondary">Events created</span><strong>@eventItems.Count</strong></div></div><div class="col-md-4"><div class="stat-card"><span class="text-secondary">Total enrolments</span><strong>@enrolmentCount</strong></div></div><div class="col-md-4"><div class="stat-card"><span class="text-secondary">Upcoming events</span><strong>@eventItems.Count(x => x.TryGetProperty("eventDate", out var d) && DateTime.TryParse(d.ToString(), out var dt) && dt >= DateTime.Today)</strong></div></div></div>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Your events</h2><a asp-action="Enrolments" class="btn btn-outline-primary">View all enrolments</a></div>
@if (eventItems.Count == 0) { <div class="alert alert-info">You have not created any events yet. Create your first RaceDay event above.</div> }
<div class="row g-3">@foreach (var e in eventItems) { var id = e.GetProperty("eventId").GetInt32(); <div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge bg-success">@e.GetProperty("status").GetString()</span><span class="text-secondary small">@e.GetProperty("eventType").GetString()</span></div><h3 class="h5 mt-2">@e.GetProperty("eventName").GetString()</h3><p class="text-secondary mb-2">@e.GetProperty("venue").GetString(), @e.GetProperty("province").GetString()</p><p class="mb-2">@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy") · @e.GetProperty("enrolmentCount").GetInt32() enrolments</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@id">Edit</a><a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-eventId="@id">Manage categories</a><form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div></div> }</div>
