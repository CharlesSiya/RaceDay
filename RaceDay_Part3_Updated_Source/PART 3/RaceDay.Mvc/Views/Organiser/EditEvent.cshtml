@model JsonDocument
@{ var e = Model.RootElement; ViewData["Title"] = "Edit event"; var route = e.TryGetProperty("routes", out var routes) && routes.ValueKind == JsonValueKind.Array && routes.GetArrayLength() > 0 ? routes[0] : default; }
<h1>Edit event</h1><form asp-action="EditEvent" method="post" enctype="multipart/form-data" class="card p-4"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><div class="mb-3"><label class="form-label">Event name</label><input name="eventName" class="form-control" value="@e.GetProperty("eventName").GetString()" required/></div><div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control">@e.GetProperty("description").GetString()</textarea></div><div class="row"><div class="col mb-3"><label class="form-label">Date</label><input name="eventDate" type="datetime-local" class="form-control" value="@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("yyyy-MM-ddTHH:mm")" required/></div><div class="col mb-3"><label class="form-label">Distance (km)</label><input name="distanceKm" type="number" step="0.1" min="0.1" class="form-control" value="@(route.ValueKind == JsonValueKind.Undefined ? "" : route.GetProperty("distanceKm").ToString())" required/></div></div><div class="row"><div class="col mb-3"><label class="form-label">Venue</label><input name="venue" class="form-control" value="@e.GetProperty("venue").GetString()" required/></div><div class="col mb-3"><label class="form-label">Province</label><input name="province" class="form-control" value="@e.GetProperty("province").GetString()" required/></div></div><div class="mb-3"><label class="form-label">Event type</label><select name="eventType" class="form-select"><option selected="@(e.GetProperty("eventType").GetString()=="Run")">Run</option><option selected="@(e.GetProperty("eventType").GetString()=="Walk")">Walk</option><option selected="@(e.GetProperty("eventType").GetString()=="Cycle")">Cycle</option></select></div><div class="mb-3"><label class="form-label">Replace banner image (optional)</label><input name="bannerImage" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-primary">Save changes</button></form>
