@model JsonDocument?
@using System.Text.Json

@{
    ViewData["Title"] = "Manage categories";

    var categories = Model?.RootElement.ValueKind == JsonValueKind.Array
        ? Model.RootElement.EnumerateArray().ToList()
        : new List<JsonElement>();

    var ev = ViewBag.Event as JsonDocument;
    var eventName = "Event";

    if (ev is not null && ev.RootElement.TryGetProperty("eventName", out var n))
    {
        eventName = n.GetString() ?? "Event";
    }

    var eventId = (int)ViewBag.EventId;
}

<h1>Manage categories</h1>
<p class="text-secondary">@eventName</p>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5">Existing categories</h2>

        @if (categories.Count == 0)
        {
            <div class="alert alert-info">No categories have been added yet.</div>
        }

        @foreach (var c in categories)
        {
            <div class="card p-3 mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@c.GetProperty("categoryName").GetString()</strong>
                        <div class="text-secondary small">
                            @c.GetProperty("distanceKm").ToString() km
                            · R@c.GetProperty("entryFee").ToString()
                            · Capacity @c.GetProperty("maxParticipants").ToString()
                        </div>
                    </div>

                    <form asp-action="DeleteCategory" method="post">
                        <input type="hidden" name="eventId" value="@eventId"/>
                        <input type="hidden" name="categoryId"
                               value="@c.GetProperty("categoryId").GetInt32()"/>
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card p-4">
            <h2 class="h5">Add a category</h2>

            <form asp-action="AddCategory" method="post">
                <input type="hidden" name="eventId" value="@eventId"/>

                <div class="mb-3">
                    <label class="form-label">Category name</label>
                    <input name="categoryName" class="form-control"
                           required maxlength="100" placeholder="e.g. 10 km Open"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Distance (km)</label>
                    <input name="distanceKm" type="number" min="0.1"
                           step="0.1" class="form-control" required/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Maximum participants</label>
                    <input name="maxParticipants" type="number" min="1"
                           class="form-control" required/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Entry fee (R)</label>
                    <input name="entryFee" type="number" min="0"
                           step="0.01" class="form-control" required/>
                </div>

                <button class="btn btn-primary w-100">Add category</button>
            </form>
        </div>
    </div>
</div>

<a asp-action="Dashboard" class="btn btn-link mt-3">← Back to dashboard</a>