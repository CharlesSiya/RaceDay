@model JsonDocument?
@{ViewData["Title"]="Enrolments";}<h1>Participant enrolments</h1>@if(Model is null){<div class="alert alert-warning">Could not load enrolments from the API.</div>}else{<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Participant</th><th>Email</th><th>Event</th><th>Category</th><th>Status</th><th>Result</th></tr></thead><tbody>@foreach(var x in Model.RootElement.EnumerateArray()){<tr><td>@x.GetProperty("participant").GetString()</td><td>@x.GetProperty("email").GetString()</td><td>@x.GetProperty("eventName").GetString()</td><td>@x.GetProperty("categoryName").GetString()</td><td><span class="badge @(x.GetProperty("status").GetString()=="Confirmed"?"bg-success":x.GetProperty("status").GetString()=="Pending"?"bg-warning text-dark":"bg-secondary")">@x.GetProperty("status").GetString()</span></td><td><form asp-action="CaptureResult" method="post" class="d-flex gap-1"><input type="hidden" name="enrollmentId" value="@x.GetProperty("enrollmentId").GetInt32()"/><input name="position" type="number" min="1" placeholder="Position" class="form-control form-control-sm" required/><input name="finishTime" placeholder="hh:mm:ss" class="form-control form-control-sm" required/><input name="paceMinutesPerKm" type="number" step="0.01" placeholder="Pace" class="form-control form-control-sm" required/><button class="btn btn-sm btn-primary">Save</button></form></td></tr>}</tbody></table></div>}
