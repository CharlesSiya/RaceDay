<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] - RaceDay</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"/>

    <link rel="stylesheet" href="~/css/site.css"/>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold"
               asp-controller="Events" asp-action="Index">🏁 RaceDay</a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Events" asp-action="Index">
                    Events
                </a>

                @if (Context.Session.GetString("Role") == "Organiser")
                {
                    <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">
                        Organiser Dashboard
                    </a>
                    <a class="nav-link" asp-controller="Organiser" asp-action="Enrolments">
                        Enrolments
                    </a>
                }

                @if (Context.Session.GetString("Role") == "Participant")
                {
                    <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">
                        My Events
                    </a>
                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                        My Results
                    </a>
                }

                @if (Context.Session.GetString("UserId") is not null)
                {
                    <a class="nav-link" asp-controller="Profile" asp-action="Index">
                        Profile
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-light btn-sm ms-2">Logout</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                        Login
                    </a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                        Register
                    </a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <partial name="_Alerts"/>
        @RenderBody()
    </main>

    <footer class="text-center text-secondary py-4">
        RaceDay · South African road events
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>