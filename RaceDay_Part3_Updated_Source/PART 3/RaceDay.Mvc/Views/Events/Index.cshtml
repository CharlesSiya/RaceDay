@model JsonDocument?
@using System.Text.Json
@{ ViewData["Title"] = "Upcoming events"; var items = Model?.RootElement.ValueKind == JsonValueKind.Array ? Model.RootElement.EnumerateArray().ToList() : new List<JsonElement>(); }
<section class="hero p-4 p-md-5 rounded-4 mb-4 text-white"><span class="text-uppercase small fw-bold">South Africa · Run · Walk · Cycle</span><h1 class="display-5 fw-bold mt-2">Your next finish line starts here.</h1><p class="lead mb-0">Discover local races, enter your next challenge and track every finish.</p></section>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="h3 mb-0">Upcoming events</h2>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-primary" asp-controller="Organiser" asp-action="CreateEvent">Create event</a>}</div>
<form method="get" class="card p-3 mb-4"><div class="row g-2"><div class="col-md-7"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event, venue or province"/></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All event types</option><option selected="@(ViewBag.EventType as string == "Run")">Run</option><option selected="@(ViewBag.EventType as string == "Walk")">Walk</option><option selected="@(ViewBag.EventType as string == "Cycle")">Cycle</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Filter</button></div></div></form>
@if(items.Count==0){<div class="alert alert-info">No events match your search. Try another filter or check back soon.</div>}
<div class="row g-3">@foreach(var e in items){var banner=e.TryGetProperty("bannerImageUrl",out var b)?b.GetString():null;<div class="col-md-6 col-lg-4"><article class="card h-100 shadow-sm overflow-hidden">@if(!string.IsNullOrWhiteSpace(banner)){<img src="@banner" class="event-banner" alt="Banner for @e.GetProperty("eventName").GetString()"/>}else{<div class="event-placeholder">🏁 RaceDay</div>}<div class="card-body d-flex flex-column"><span class="badge bg-success align-self-start">@e.GetProperty("status").GetString()</span><h3 class="h5 mt-2">@e.GetProperty("eventName").GetString()</h3><p class="text-secondary mb-2">@e.GetProperty("venue").GetString(), @e.GetProperty("province").GetString()</p><p class="small">@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy · HH:mm") · @e.GetProperty("eventType").GetString()</p><a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event</a></div></article></div>}</div>
