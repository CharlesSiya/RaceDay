@model JsonDocument
@using System.Text.Json
@{ var e=Model.RootElement; ViewData["Title"]=e.GetProperty("eventName").GetString(); var banner=e.TryGetProperty("bannerImageUrl",out var b)?b.GetString():null; var categories=e.TryGetProperty("categories",out var cats)&&cats.ValueKind==JsonValueKind.Array?cats.EnumerateArray().ToList():new List<JsonElement>(); var routeDistance="Not specified"; if(e.TryGetProperty("routes",out var rs)&&rs.ValueKind==JsonValueKind.Array&&rs.GetArrayLength()>0){routeDistance=rs[0].GetProperty("distanceKm").ToString()+" km";} var mapUrl=""; if(e.TryGetProperty("routes",out var routeList)&&routeList.ValueKind==JsonValueKind.Array&&routeList.GetArrayLength()>0&&routeList[0].TryGetProperty("mapUrl",out var map)){mapUrl=map.GetString()??"";} }
@if(!string.IsNullOrWhiteSpace(banner)){<img src="@banner" alt="Event banner" class="detail-banner mb-4"/>}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><span class="badge bg-success">@e.GetProperty("status").GetString()</span><h1 class="mt-2">@e.GetProperty("eventName").GetString()</h1></div><span class="badge text-bg-dark">@e.GetProperty("eventType").GetString()</span></div>
<p class="lead">@e.GetProperty("description").GetString()</p><div class="card p-3 mb-4"><div class="row g-3"><div class="col-md-4"><span class="text-secondary small">Date</span><div class="fw-semibold">@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMMM yyyy · HH:mm")</div></div><div class="col-md-4"><span class="text-secondary small">Venue</span><div class="fw-semibold">@e.GetProperty("venue").GetString(), @e.GetProperty("province").GetString()</div></div><div class="col-md-4"><span class="text-secondary small">Route distance</span><div class="fw-semibold">@routeDistance</div></div></div></div>
@if(!string.IsNullOrWhiteSpace(mapUrl)){<p><a href="@mapUrl" target="_blank" rel="noopener">View route map</a></p>}<h2 class="h4">Available categories</h2>@if(categories.Count==0){<div class="alert alert-info">The organiser has not added categories yet.</div>}
@foreach(var c in categories){<div class="card p-3 mb-2"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@c.GetProperty("categoryName").GetString()</strong><div class="text-secondary small">@c.GetProperty("distanceKm").ToString() km · Entry R@c.GetProperty("entryFee").ToString() · Maximum @c.GetProperty("maxParticipants").ToString()</div></div>@if(Context.Session.GetString("Role")=="Participant"){<form asp-controller="Events" asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><button class="btn btn-primary">Enter event</button></form>}else if(Context.Session.GetString("UserId") is null){<a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Log in to enter</a>}</div></div>}
